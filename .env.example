# ─── CV-Hub configuration ────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# --- App / Branding ---
APP_NAME=CV-Hub
APP_BASE_URL=http://localhost:8080          # public URL of your instance
# Frontend brand name is baked at build time; rebuild the frontend with
# VITE_APP_NAME to change the logo text (defaults to CV-Hub).

# --- Database (used by docker-compose) ---
POSTGRES_USER=cvhub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cvhub

# --- Backend ---
JWT_SECRET=                                  # REQUIRED: 32+ random bytes
ALLOWED_ORIGINS=http://localhost:8080        # comma-separated extra CORS origins
# Every other origin (including "null") gets 403 right away. The address the
# app runs under MUST be listed here; by default only the localhost dev ports
# are allowed.

# Behind exactly ONE reverse proxy (Traefik, nginx, the bundled frontend): 1.
# Without it every request appears to come from the proxy's address — five
# failed logins then lock the login for everyone, and the PDF quota is shared
# by all users. The service warns on the first forwarded request. Leave it
# empty when the backend is reachable directly; otherwise any rate limit can
# be bypassed with a header.
TRUST_PROXY=1

# --- PDF renderer (optional; defaults in brackets) ---
# PDF_MAX_PARALLEL=2       concurrent jobs
# PDF_MAX_QUEUE=10         waiting jobs; beyond that the service answers 503
# PDF_TIMEOUT_MS=30000     load + print per job
# PDF_CHROMIUM_PATH=       local runs/tests only, when the Playwright browser is missing
# PDF_CHROMIUM_SANDBOX=1   enable the Chromium sandbox. Only if the container
#                          allows it (seccomp profile with user namespaces, see
#                          pdf-service/SICHERHEIT.md). If Chromium does not start
#                          with it, the service logs a warning and falls back to
#                          --no-sandbox.
# Without an account (demo) there is an additional limit: at most one PDF at a
# time and 60 per hour per network (/24 or /64). Invoices and contract
# documents have a queue of their own (no variable).

# Cleanup job (unreferenced photos, expired tokens, old logs) runs at start-up
# and then daily. 0 disables it (tests only).
# JANITOR=1

# --- First admin (bootstrap on start; created if missing, password reset each boot) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                              # min 8 chars
ADMIN_EMAIL=                                 # optional, enables 2FA / password reset

# --- Email (optional; without it, mail sending is a no-op) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CV-Hub <no-reply@example.com>

# --- MCP server (optional; mcp/, hosted HTTP mode only) ---
# The hosted endpoint is multi-tenant: every user connects their own AI client
# and sees only their own data. Authorization is OAuth 2.1 with dynamic client
# registration — the only way a remote MCP client (Claude and friends) can
# connect; there is no field for a static bearer token on their side.
#
# The authorization server itself lives in the backend (pdf-service), because
# that is where users, sessions and the database are.
MCP_HTTP=1                                   # 1 = hosted HTTP instead of stdio
MCP_PUBLIC_URL=https://cv.example.com        # public origin; used in the metadata
MCP_AUTH_BASE=                               # public address of the OAuth endpoints,
                                             # e.g. https://cv.example.com/pdfapi/api/oauth
                                             # — only needed if the backend sits behind a
                                             # path prefix the proxy strips
# CV_API_KEY must NOT be set in hosted mode: it would make every caller act as
# the same account. It is for stdio mode only.

# --- OAuth (backend) ---
OAUTH_PUBLIC_BASE=                           # public address of the OAuth endpoints as
                                             # seen from outside; defaults to
                                             # <PUBLIC_BASE_URL>/oauth

# --- Paid mode: application pass via Mollie (optional, OFF by default) ---
# Everything local stays free and export is never behind the paywall. The
# purchase is only enabled when BILLING_ENABLED=1 AND every required value is
# set (MOLLIE_API_KEY, SELLER_NAME, SELLER_ADDRESS, SELLER_EMAIL, SELLER_PHONE,
# PUBLIC_BASE_URL, TERMS_VERSION, ALTCHA_HMAC_KEY). If something is missing the
# service says what at start-up — without printing values. Withdrawal,
# cancellation and the webhook keep working with BILLING_ENABLED=0, so running
# contracts can still be handled.
# The contract texts under app/src/legal are templates written for German law;
# have them reviewed before you sell anything.
BILLING_ENABLED=0
# Start with test_… (Mollie test mode); use live_… only after acceptance.
# MOLLIE_API_KEY=
# Tests only (mock server). Leave empty in production.
# MOLLIE_API_BASE=https://api.mollie.com/v2
# Price in cents (final price) and duration in days.
# PASS_PRICE_CENTS=900
# PASS_DAYS=90
# PRODUCT_NAME=CV-Hub
# Invoice numbers: <PREFIX>-<year>-<sequence>, e.g. CV-2026-0001.
# INVOICE_PREFIX=CV
# Seller details for invoice, order confirmation, terms and withdrawal notice.
# Address on one line, separate lines with |: "Example Street 1 | 12345 City".
# Keep them in line with app/src/data/operator.ts.
# SELLER_NAME=Your Name
# SELLER_ADDRESS=Example Street 1 | 12345 City
# SELLER_EMAIL=billing@example.com
# SELLER_PHONE=+49 000 0000000
# Tax number or business ID; printed on the invoice when set.
# SELLER_TAX_ID=
# Version of the terms and withdrawal notice, stored with every order. Raise
# it whenever the texts change in substance.
# TERMS_VERSION=2026-10-09
# WITHDRAWAL_VERSION=      (default: TERMS_VERSION)
# Where declarations that need manual handling go (unmatched withdrawal,
# extraordinary termination). Default: ACCESS_NOTIFY_EMAIL, then SELLER_EMAIL.
# BILLING_NOTIFY_EMAIL=
# Public withdrawal and public cancellation (without login) only take effect
# after the customer clicks the link sent to the order address:
# <PUBLIC_BASE_URL>/widerruf/bestaetigen?token=… or /kuendigen/bestaetigen?token=…
# Without PUBLIC_BASE_URL there is no link — every such declaration then goes
# to BILLING_NOTIFY_EMAIL for manual handling. Unconfirmed declarations are
# reported there by the background run after 14 days (it also runs with
# BILLING_ENABLED=0, as long as BILLING_JOBS is not 0).
# Only if the webhook is not reachable at <PUBLIC_BASE_URL>/pdfapi/api/billing/webhook.
# BILLING_WEBHOOK_URL=
# Background run (retry confirmations and refunds) every 10 minutes.
# 0 disables it (tests only).
# BILLING_JOBS=1
# Payment methods named on the order page (§ 312j BGB), separated by |; must
# match the methods active in your Mollie profile.
# PAYMENT_METHODS=Credit card|PayPal

# --- Free-tier limits (optional, OFF by default) ---
# 1 = without an active pass a visitor gets the PDF of the résumé, one version
# and one document language; Word export, cover letters, further versions and
# languages become part of the pass. Only takes effect together with a paid
# mode that is ready to sell (BILLING_ENABLED=1 and every seller value set);
# otherwise everything stays free. GET /api/billing/offer reports it as
# freeTier.limited. It is an offer boundary, not a security boundary: Word is
# generated in the browser and the code is open.
# A self-hosted instance normally leaves this out. docker-compose.yml does not
# pass it on; to use it, add FREE_TIER_LIMITS to the cv-api environment there.
# FREE_TIER_LIMITS=0

# --- Open registration with bot protection (optional, off by default) ---
# 1 = accounts with e-mail + password without an invite code (double opt-in).
OPEN_REGISTRATION=0
# HMAC key for ALTCHA (self-hosted proof of work). Long and random, e.g.
# openssl rand -hex 32. Required for open registration and for purchases.
# ALTCHA_HMAC_KEY=
# Cost of the challenge (defaults; only change if solving takes too long):
# ALTCHA_COST=2000  ALTCHA_COUNTER_MIN=2000  ALTCHA_COUNTER_MAX=6000  ALTCHA_TTL_S=600

# --- Vouchers and free access (optional) ---
# No variables of their own. The redemption address is PUBLIC_BASE_URL + /code.
# New visitors can only redeem a code if OPEN_REGISTRATION=1 and
# ALTCHA_HMAC_KEY are set (otherwise only existing or invited accounts).
# Codes are created in the admin area, never here. On first start the service
# back-fills access grants for existing accounts without changing any access
# period (differences are logged at startup: "access-grants: Migration").
# See pdf-service/GUTSCHEINE.md.

# --- Guides under /ratgeber/ (optional, build time only) ---
# Static pages built from app/content/ratgeber/*.md; see
# app/content/ratgeber/README.md. Only needed to pull articles from an
# Outline wiki before the build; without them the files in the repo are used.
# OUTLINE_URL=https://wiki.example.com
# OUTLINE_RATGEBER_TOKEN=
# OUTLINE_RATGEBER_COLLECTION=
