# ─── CV-Hub configuration ────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# --- App / Branding ---
APP_NAME=CV-Hub
APP_BASE_URL=http://localhost:8080          # public URL of your instance
# Frontend brand name is baked at build time; rebuild the frontend with
# VITE_APP_NAME to change the logo text (defaults to CV-Hub).

# --- Database (used by docker-compose) ---
POSTGRES_USER=cvhub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cvhub

# --- Backend ---
JWT_SECRET=                                  # REQUIRED: 32+ random bytes
ALLOWED_ORIGINS=http://localhost:8080        # comma-separated extra CORS origins

# --- First admin (bootstrap on start; created if missing, password reset each boot) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                              # min 8 chars
ADMIN_EMAIL=                                 # optional, enables 2FA / password reset

# --- Email (optional; without it, mail sending is a no-op) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CV-Hub <no-reply@example.com>

# --- MCP server (optional; mcp/, hosted HTTP mode only) ---
# The hosted endpoint is multi-tenant: every user connects their own AI client
# and sees only their own data. Authorization is OAuth 2.1 with dynamic client
# registration — the only way a remote MCP client (Claude and friends) can
# connect; there is no field for a static bearer token on their side.
#
# The authorization server itself lives in the backend (pdf-service), because
# that is where users, sessions and the database are.
MCP_HTTP=1                                   # 1 = hosted HTTP instead of stdio
MCP_PUBLIC_URL=https://cv.example.com        # public origin; used in the metadata
MCP_AUTH_BASE=                               # public address of the OAuth endpoints,
                                             # e.g. https://cv.example.com/pdfapi/api/oauth
                                             # — only needed if the backend sits behind a
                                             # path prefix the proxy strips
# CV_API_KEY must NOT be set in hosted mode: it would make every caller act as
# the same account. It is for stdio mode only.

# --- OAuth (backend) ---
OAUTH_PUBLIC_BASE=                           # public address of the OAuth endpoints as
                                             # seen from outside; defaults to
                                             # <PUBLIC_BASE_URL>/oauth
