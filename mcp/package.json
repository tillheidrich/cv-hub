{
  "name": "cv-hub-mcp",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "MCP-Server für CV-Hub — Markdown-Brücke für registrierte Nutzer via persönlichem API-Key. stdio (lokal) oder HTTP (gehostet).",
  "bin": {
    "cv-hub-mcp": "cv-mcp.mjs"
  },
  "scripts": {
    "start": "node cv-mcp.mjs",
    "start:http": "MCP_HTTP=1 node cv-mcp.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8",
    "express": "^5.1.0"
  }
}
